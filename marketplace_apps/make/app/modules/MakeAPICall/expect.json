[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "required": true,
    "validate": {
      "pattern": "^/"
    },
    "help": "Path relative to https://app.humaia.com.br/api/v1, starting with a slash. For example: /conversations?limit=5. Documentation: https://app.humaia.com.br/automacoes"
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "PUT",
        "value": "PUT"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "help": "You do not need to add the authorization header; it is added for you.",
    "default": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query String",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body",
    "help": "JSON body for POST, PUT and PATCH requests."
  }
]

# Copie este arquivo para .env.local (mesma pasta) e preencha. O .env.local nunca vai pro git.
# Token da Make: Perfil > API access > + API token, com os escopos sdk-apps:read e sdk-apps:write.
MAKE_API_KEY=
# Zona da sua organização na Make, só o endereço (veja na barra do navegador: eu1.make.com, eu2.make.com, us1.make.com ou us2.make.com).
MAKE_ZONE=
# Público do app. Deixe global (valor do exemplo oficial da Make CLI).
MAKE_APP_AUDIENCE=global

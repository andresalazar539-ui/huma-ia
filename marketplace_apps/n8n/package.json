{
	"name": "n8n-nodes-humaia",
	"version": "0.1.0",
	"description": "n8n nodes for HUMA IA, the AI sales assistant for WhatsApp, Instagram and website chat",
	"license": "MIT",
	"homepage": "https://humaia.com.br",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"humaia",
		"huma",
		"whatsapp",
		"instagram",
		"sales",
		"ai"
	],
	"author": {
		"name": "andresalazar539-ui",
		"email": "contato@humaia.com.br"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/andresalazar539-ui/n8n-nodes-humaia.git"
	},
	"bugs": {
		"url": "https://github.com/andresalazar539-ui/n8n-nodes-humaia/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test \"test/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/HumaIaOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/HumaIa/HumaIa.node.js",
			"dist/nodes/HumaIaTrigger/HumaIaTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
